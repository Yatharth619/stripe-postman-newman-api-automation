      "item": [
        {
          "name": "Create Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Check status code\", () => {\r",
                  "    pm.response.to.have.status(200)\r",
                  "})\r",
                  "const userDetail = pm.response.json();\r",
                  "pm.test(\"Check whether customer was created successfully\", () => {\r",
                  "    pm.expect(userDetail.id).to.not.be.null\r",
                  "})\r",
                  "pm.test(\"Check returned name and email matches the one submitted\", () => {\r",
                  "    pm.expect(userDetail.name).to.equal(pm.environment.get(\"name\"))\r",
                  "    pm.expect(userDetail.email).to.equal(pm.environment.get(\"email\"))\r",
                  "})\r",
                  "pm.test(\"Check data types are correct\", () => {\r",
                  "   pm.expect(userDetail.id).to.be.a('string')\r",
                  "   pm.expect(userDetail.name).to.be.a('string')\r",
                  "   pm.expect(userDetail.email).to.be.a('string')\r",
                  "})\r",
                  "pm.test(\"Fetch customerId\", () => {\r",
                  "    pm.environment.set(\"customerId\", userDetail.id)\r",
                  "})\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "type": "text",
                  "key": "name",
                  "value": "{{name}}"
